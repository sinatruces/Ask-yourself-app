    "outline-width": {
      "$type": "dimension",
      "$value": "2px"
    },
    "shadow-offset": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "hard drop downward, no blur — like the thick base of the logo check"
    },
    "radius": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "no rounded corners; use stepped (notched) corners instead"
    }

{
  "$description": "Didit design-system tokens (W3C Design Tokens format). Extends docs/02-brand/tokens.json (colors, base themes, pixel, font); references like {color.brand.leaf} resolve against both files. Build: python3 tools/design-system/build_tokens.py",
  "theme": {
    "light": {
      "surface-sunken": { "$type": "color", "$value": "{color.neutral.100}", "$description": "tracks, inactive cells" },
      "surface-pressed": { "$type": "color", "$value": "{color.green.100}" },
      "track": { "$type": "color", "$value": "{color.neutral.200}", "$description": "empty part of bars and rings" },
      "scrim": { "$type": "color", "$value": "#0617207A", "$description": "behind sheets and dialogs (شب، ۴۸٪)" },
      "disabled-bg": { "$type": "color", "$value": "{color.neutral.100}" },
      "disabled-text": { "$type": "color", "$value": "{color.neutral.500}" },
      "chain-yes": { "$type": "color", "$value": "{color.brand.leaf}" },
      "chain-freeze": { "$type": "color", "$value": "{color.brand.sprout}" },
      "chain-no": { "$type": "color", "$value": "{color.neutral.200}" },
      "chain-off": { "$type": "color", "$value": "{color.neutral.100}", "$description": "day not scheduled" },
      "xp-fill": { "$type": "color", "$value": "{color.semantic.medal}" },
      "on-medal": { "$type": "color", "$value": "{color.brand.ink}" },
      "highlight": { "$type": "color", "$value": "{color.brand.sprout}", "$description": "2dp top light on primary buttons (from the logo)" },
      "shadow": { "$type": "color", "$value": "{color.brand.ink}", "$description": "hard pixel shadow" }
    },
    "dark": {
      "outline": { "$type": "color", "$value": "{color.green.600}", "$description": "overrides brand #000000: black outline and dark surface are under 3:1 on شب (WCAG 1.4.11); green like the on-dark logo outline" },
      "surface-sunken": { "$type": "color", "$value": "{color.neutral.800}" },
      "surface-pressed": { "$type": "color", "$value": "{color.green.900}" },
      "track": { "$type": "color", "$value": "{color.neutral.700}" },
      "scrim": { "$type": "color", "$value": "#000000A3" },
      "disabled-bg": { "$type": "color", "$value": "{color.neutral.800}" },
      "disabled-text": { "$type": "color", "$value": "{color.neutral.500}" },
      "chain-yes": { "$type": "color", "$value": "{color.brand.leaf}" },
      "chain-freeze": { "$type": "color", "$value": "{color.green.800}" },
      "chain-no": { "$type": "color", "$value": "{color.neutral.700}" },
      "chain-off": { "$type": "color", "$value": "{color.neutral.800}" },
      "xp-fill": { "$type": "color", "$value": "{color.semantic.medal}" },
      "on-medal": { "$type": "color", "$value": "{color.brand.ink}" },
      "highlight": { "$type": "color", "$value": "{color.brand.sprout}" },
      "shadow": { "$type": "color", "$value": "#000000" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px", "$description": "screen side margin" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "size": {
    "touch-min": { "$type": "dimension", "$value": "48px", "$description": "minimum touch target" },
    "icon": {
      "md": { "$type": "dimension", "$value": "24px", "$description": "1 icon pixel = 2dp" },
      "lg": { "$type": "dimension", "$value": "36px", "$description": "1 icon pixel = 3dp" },
      "xl": { "$type": "dimension", "$value": "48px", "$description": "1 icon pixel = 4dp" }
    },
    "numeral-unit": {
      "sm": { "$type": "dimension", "$value": "3px", "$description": "pixel numeral 21dp tall" },
      "md": { "$type": "dimension", "$value": "4px", "$description": "28dp tall" },
      "lg": { "$type": "dimension", "$value": "6px", "$description": "42dp tall" },
      "xl": { "$type": "dimension", "$value": "8px", "$description": "56dp tall" }
    },
    "character": {
      "sm": { "$type": "dimension", "$value": "48px", "$description": "16px sprite x3" },
      "md": { "$type": "dimension", "$value": "96px", "$description": "x6" },
      "lg": { "$type": "dimension", "$value": "160px", "$description": "x10" }
    },
    "content-max": { "$type": "dimension", "$value": "480px", "$description": "content width on tablets" }
  },
  "shape": {
    "notch": { "$type": "dimension", "$value": "4px", "$description": "stepped corner: one 4dp square cut from each corner" },
    "notch-sm": { "$type": "dimension", "$value": "2px", "$description": "chips and small cells" },
    "outline": { "$type": "dimension", "$value": "{pixel.outline-width}" },
    "border": { "$type": "dimension", "$value": "2px", "$description": "plain fields and dividers use border color, square corners" },
    "divider": { "$type": "dimension", "$value": "1px" }
  },
  "elevation": {
    "rest": { "$type": "dimension", "$value": "{pixel.shadow-offset}", "$description": "hard shadow straight down, no blur" },
    "low": { "$type": "dimension", "$value": "2px", "$description": "chips, small cells" },
    "pressed": { "$type": "dimension", "$value": "0px", "$description": "component moves down by rest offset, shadow disappears" }
  },
  "type": {
    "display": { "$type": "typography", "$value": { "fontSize": "32px", "lineHeight": "44px", "fontWeight": 900 } },
    "question": { "$type": "typography", "$value": { "fontSize": "22px", "lineHeight": "36px", "fontWeight": 800 } },
    "title-1": { "$type": "typography", "$value": { "fontSize": "20px", "lineHeight": "32px", "fontWeight": 700 } },
    "title-2": { "$type": "typography", "$value": { "fontSize": "17px", "lineHeight": "28px", "fontWeight": 700 } },
    "answer": { "$type": "typography", "$value": { "fontSize": "18px", "lineHeight": "28px", "fontWeight": 800 }, "$description": "yes/no buttons" },
    "button": { "$type": "typography", "$value": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": 700 } },
    "body": { "$type": "typography", "$value": { "fontSize": "15px", "lineHeight": "26px", "fontWeight": 400 } },
    "small": { "$type": "typography", "$value": { "fontSize": "13px", "lineHeight": "22px", "fontWeight": 500 } },
    "label": { "$type": "typography", "$value": { "fontSize": "12px", "lineHeight": "20px", "fontWeight": 600 } }
  },
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "0ms" },
      "fast": { "$type": "duration", "$value": "80ms", "$description": "press, toggle" },
      "base": { "$type": "duration", "$value": "120ms", "$description": "state change, chip" },
      "slow": { "$type": "duration", "$value": "200ms", "$description": "sheet, card enter" },
      "check": { "$type": "duration", "$value": "480ms", "$description": "signature: check builds pixel by pixel after yes" },
      "celebrate": { "$type": "duration", "$value": "1200ms", "$description": "level and medal moments" }
    },
    "steps": {
      "short": { "$type": "number", "$value": 2, "$description": "steps() count for fast/base" },
      "long": { "$type": "number", "$value": 4, "$description": "steps() count for slow" }
    },
    "sprite-fps": { "$type": "number", "$value": 6, "$description": "character animation, 4 to 8 allowed" }
  },
  "z": {
    "base": { "$type": "number", "$value": 0 },
    "sticky": { "$type": "number", "$value": 10 },
    "fab": { "$type": "number", "$value": 20 },
    "sheet": { "$type": "number", "$value": 30 },
    "dialog": { "$type": "number", "$value": 40 },
    "toast": { "$type": "number", "$value": 50 }
  },
  "component": {
    "button": {
      "height": { "$type": "dimension", "$value": "48px" },
      "height-sm": { "$type": "dimension", "$value": "40px" },
      "padding-x": { "$type": "dimension", "$value": "{space.5}" }
    },
    "answer": {
      "height": { "$type": "dimension", "$value": "56px" },
      "gap": { "$type": "dimension", "$value": "{space.3}" }
    },
    "field": {
      "height": { "$type": "dimension", "$value": "52px" },
      "padding-x": { "$type": "dimension", "$value": "{space.4}" }
    },
    "card": {
      "padding": { "$type": "dimension", "$value": "{space.4}" },
      "gap": { "$type": "dimension", "$value": "{space.3}" }
    },
    "chip": {
      "height": { "$type": "dimension", "$value": "36px" },
      "padding-x": { "$type": "dimension", "$value": "{space.3}" }
    },
    "chain-cell": {
      "size": { "$type": "dimension", "$value": "16px" },
      "gap": { "$type": "dimension", "$value": "{space.1}" }
    },
    "calendar-cell": {
      "size": { "$type": "dimension", "$value": "40px" }
    },
    "progress-bar": {
      "height": { "$type": "dimension", "$value": "16px", "$description": "4 brand pixels incl. outline" },
      "segment": { "$type": "dimension", "$value": "4px", "$description": "fill grows in whole 4dp segments" }
    },
    "ring": {
      "size": { "$type": "dimension", "$value": "112px", "$description": "pixel adherence ring, 28 units of 4dp" },
      "thickness": { "$type": "dimension", "$value": "12px" }
    },
    "tab-bar": {
      "height": { "$type": "dimension", "$value": "64px" }
    },
    "fab": {
      "size": { "$type": "dimension", "$value": "56px" }
    },
    "sheet": {
      "handle-width": { "$type": "dimension", "$value": "32px" },
      "padding": { "$type": "dimension", "$value": "{space.6}" }
    }
  }
}
